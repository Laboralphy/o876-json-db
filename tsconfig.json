{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "./",
    "declaration": true,
    "emitDeclarationOnly": false,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*", "index.ts"]
}
